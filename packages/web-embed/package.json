{
  "name": "@unionkeyhq/web-embed",
  "version": "0.0.1",
  "main": "index.js",
  "description": "Multi-chain support for BTC/ETH/BNB/NEAR/Polygon/Solana/Avalanche/Fantom and others",
  "scripts": {
    "start": "WEB_PORT=3008 expo start --web",
    "build": "rm -rf ./web-build && GENERATE_SOURCEMAP=false expo export:web && cp ./web-build/index.html ./web-build/404.html && sh ./postbuild.sh",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@unionkeyhq/cardano-coin-selection-asmjs": "https://github.com/UnionKeyHQ/coin-selection/releases/download/v1.0.0-unionkey/unionkeyhq-cardano-coin-selection-asmjs-1.1.0.tgz",
    "@unionkeyhq/components": "*",
    "@unionkeyhq/engine": "*",
    "@unionkeyhq/kit": "*",
    "expo": "49.0.6",
    "firebase": "^9.8.2",
    "react-router-dom": "^6.3.0"
  },
  "private": true
}
