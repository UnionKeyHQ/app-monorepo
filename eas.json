{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "cache": {  
        "disabled": false  
      }, 
      "env": {
        "NODE_VERSION": "20.0.0",
        "NODE_OPTIONS": "--max-old-space-size=12000",
        "NO_FLIPPER": "1"
      },
      "ios": {
        "resourceClass": "large"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_VERSION": "20.0.0",
        "NODE_OPTIONS": "--max-old-space-size=12000",
        "NO_FLIPPER": "1"
      },
      "ios": {
        "resourceClass": "large"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_VERSION": "20.0.0",
        "NODE_OPTIONS": "--max-old-space-size=12000",
        "NO_FLIPPER": "1"
      }
     
    }
  },
  "submit": {
    "production": {}
  }
}
