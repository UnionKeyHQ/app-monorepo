{
  "cli": {
    "version": ">= 5.4.0"
  },
  "build": {
    "base": {
      "node": "20.0.0",
      "env": {
        "YARN_ENABLE_INLINE_BUILDS": "0",
        "YARN_NODE_LINKER": "node-modules",
        "PLATFORM": "ios",
        "EXPO_SKIP_PODS_CACHE": "true",
        "NO_FLIPPER": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_SKIP_AUTO_SETUP": "true"
      },
      "android": {
        "image": "ubuntu-22.04-jdk-17-ndk-r25b",
        "ndk": "25.1.8937393",
        "env": {
          "PLATFORM": "android",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true",
          "SENTRY_SKIP_AUTO_SETUP": "true"
        }
      },
      "ios": {
        "image": "macos-sonoma-14.6-xcode-16.0",
        "resourceClass": "default",
        "autoIncrement": "buildNumber",
        "env": {
          "PLATFORM": "ios",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true",
          "SENTRY_SKIP_AUTO_SETUP": "true"
        }
      }
    },

    "production-store": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleGoogleRelease",
        "env": {
          "ANDROID_CHANNEL": "google"
        }
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },

    "production": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease",
        "env": {
          "ANDROID_CHANNEL": "direct"
        }
      },
      "ios": {
        "autoIncrement": "buildNumber",
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },

    "production-huawei": {
      "extends": "base",
      "distribution": "store",
      "env": {
        "ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease",
        "env": {
          "ANDROID_CHANNEL": "huawei"
        }
      }
    }
  }
}
